# homelab-backup service environment
# Copy to the homelab-backup repo root as homelab-backup.env and fill in.
# All paths the agent touches are derived from THIS file — no hard-coded paths.

# Where backup-services.yaml lives (in your homelab repo, single source of truth).
# The homelab-backup/ folder name matters: Homeio (if you run it) auto-detects
# this agent by looking for backup-services.yaml at exactly this path, under
# whatever folder you point its QUADLET_SERVICES_ROOT at.
HOMELAB_BACKUP_CONFIG=/srv/homelab/services/homelab-backup/backup-services.yaml

# Data root (what `files` procedures back up)
HOMELAB_DATA_ROOT=/srv/homelab-data

# Where the restic repo, password, markers and run history live
HOMELAB_BACKUP_STATE=/srv/homelab-data/backups/state

# Base dir where service quadlet/env files live (your homelab repo checkout)
HOMELAB_CONTAINER_BASE_DIR=/srv/homelab/services

# Dashboard: bind addr (default 127.0.0.1; use 0.0.0.0 for LAN) and port
HOMELAB_BACKUP_ADDR=
HOMELAB_BACKUP_PORT=3095

# Offsite sync (rsync push of the restic repo; empty host disables)
OFFSITE_HOST=
OFFSITE_PATH=
OFFSITE_MIN_HOURS=20
